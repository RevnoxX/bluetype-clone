    <!-- Limitations Screen -->
    <string name="limitations_title">How BlueType Works &amp; Limitations</string>
    <string name="limitation_1_title">1. Keystroke Simulation, Not Cloud Sync</string>
    <string name="limitation_1_desc">Bluetooth HID has no concept of clipboard or paste. BlueType registers your phone as a physical Bluetooth keyboard and simulates keystrokes for each character at high speed. Make sure your cursor is focused in the text box on Windows.</string>
    <string name="limitation_2_title">2. Character Set &amp; US Keyboard Layout</string>
    <string name="limitation_2_desc">Standard USB HID communicates keycodes assuming a US QWERTY layout. Extended Unicode (emoji, non-Latin alphabets) cannot be simulated reliably over standard HID without special PC drivers.</string>
    <string name="limitation_3_title">3. Chipset Compatibility</string>
    <string name="limitation_3_desc">Android requires hardware Bluetooth HID Device role support. Some phone chipsets do not support this feature.</string>
    <string name="limitation_4_title">4. Zero Network &amp; Privacy First</string>
    <string name="limitation_4_desc">BlueType requests zero Internet permissions. Your clipboard data never leaves your device except over the direct local Bluetooth connection.</string>

    <!-- Onboarding / Permissions -->
    <string name="onboarding_title">Permissions &amp; Setup</string>
    <string name="onboarding_desc">BlueType requires local Bluetooth permissions to act as an input keyboard for your Windows PC.</string>
